{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Start",
            "type": "shell",
            "command": "wsl docker compose up postgres redis -d --wait",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "steam-dev"
            }
        },
        {
            "label": "Backend: Run",
            "type": "shell",
            "command": "wsl --cd /mnt/c/Users/derek/repos/steam-storefront/backend/SteamStorefront dotnet run",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "steam-dev"
            }
        },
        {
            "label": "Frontend: Run",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "steam-dev"
            }
        },
        {
            "label": "Services",
            "dependsOn": [
                "Backend: Run",
                "Frontend: Run"
            ],
            "dependsOrder": "parallel"
        },
        {
            "label": "Start Dev",
            "dependsOn": [
                "Docker: Start",
                "Services"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Stop Dev",
            "type": "shell",
            "command": ".\\stop.ps1",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass"
                    ]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}